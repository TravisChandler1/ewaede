// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String            @unique
  emailVerified     DateTime?         @map("email_verified")
  image             String?
  password          String
  role              UserRole          @default(STUDENT)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  enrollments       Enrollment[]
  createdCourses    Course[]          @relation("CourseInstructor")
  taughtCourses     Course[]          @relation("CourseTeacher")
  bookClubs         BookClub[]        @relation("BookClubCreator")
  bookClubMembers   BookClubMember[]
  sentMessages      Message[]         @relation("SentMessages")
  receivedMessages  Message[]         @relation("ReceivedMessages")
  notifications     Notification[]
  sessions          Session[]         @relation("SessionTeacher")
  sessionAttendees  SessionAttendee[]
  discussions       Discussion[]
  userProgress      UserProgress[]
  auditLogs         AdminAuditLog[]
  newsletterSubscriptions NewsletterSubscription[]
  uploadedFiles     File[]
  
  @@map("users")
}

model NewsletterSubscription {
  id            String   @id @default(cuid())
  email         String   @unique
  status        String   @default("SUBSCRIBED")
  subscribedAt  DateTime @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relations
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("newsletter_subscriptions")
}

model StudentProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  level         Level     @default(NOVICE)
  progress      Int       @default(0)
  achievements  String[]  @default([])
  bio           String?
  dateOfBirth   DateTime?
  phoneNumber   String?
  country       String?
  timezone      String?
  lastActive    DateTime?
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   AssignmentSubmission[]
  
  @@map("student_profiles")
}

model TeacherProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  bio             String?
  qualifications  String[]
  experience      Int?        // Years of experience
  specialization  String[]
  rating          Float?      @default(0)
  totalRatings    Int         @default(0)
  isVerified      Boolean     @default(false)
  status          String      @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?     // Reason for rejection if status is REJECTED
  submittedAt     DateTime    @default(now()) @map("submitted_at")
  reviewedAt      DateTime?   @map("reviewed_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("teacher_profiles")
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  action      String    // e.g., "TEACHER_APPROVED", "COURSE_CREATED"
  entityType  String    // e.g., "TEACHER", "COURSE"
  entityId    String
  performedBy String    @map("performed_by") // Admin user ID
  oldData     Json?     @map("old_data")
  newData     Json?     @map("new_data")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@index([performedBy])
  @@map("admin_audit_logs")
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String       @db.Text
  price         Float
  level         Level
  duration      Int          // in weeks
  thumbnail     String?
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  
  // Relations
  instructorId   String       @map("instructor_id")
  instructor     User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  teacherId      String?      @map("teacher_id")
  teacher        User?        @relation("CourseTeacher", fields: [teacherId], references: [id])
  modules        Module[]
  enrollments    Enrollment[]
  sessions       Session[]
  
  @@map("courses")
}

model Module {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  order       Int
  isPublished Boolean   @default(false)
  courseId    String    @map("course_id")
  
  // Relations
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  
  @@map("modules")
}

model Lesson {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  content     String    @db.Text
  videoUrl    String?   @map("video_url")
  duration    Int?      // in minutes
  order       Int
  isPublished Boolean   @default(false)
  isFree      Boolean   @default(false)
  moduleId    String    @map("module_id")
  
  // Relations
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  userProgress UserProgress[]
  
  @@map("lessons")
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  dueDate     DateTime? @map("due_date")
  totalPoints Int       @default(100) @map("total_points")
  lessonId    String    @map("lesson_id")
  
  // Relations
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  
  @@map("assignments")
}

model AssignmentSubmission {
  id            String    @id @default(cuid())
  content       String    @db.Text
  grade         Int?
  feedback      String?   @db.Text
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  gradedAt      DateTime? @map("graded_at")
  assignmentId  String    @map("assignment_id")
  studentId     String    @map("student_id")
  
  // Relations
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@map("assignment_submissions")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  status      EnrollmentStatus @default(ACTIVE)
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([userId, courseId])
  @@map("enrollments")
}

model Session {
  id           String            @id @default(cuid())
  title        String
  description  String?           @db.Text
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  meetingUrl   String?           @map("meeting_url")
  isRecurring  Boolean           @default(false)
  recurringId  String?           @map("recurring_id")
  teacherId    String            @map("teacher_id")
  courseId     String?           @map("course_id")
  
  // Relations
  teacher      User              @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  course       Course?           @relation(fields: [courseId], references: [id])
  attendees    SessionAttendee[]
  
  @@map("sessions")
}

model SessionAttendee {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  
  // Relations
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([sessionId, userId])
  @@map("session_attendees")
}

model Book {
  id            String    @id @default(cuid())
  title         String
  author        String
  description   String    @db.Text
  coverImage    String?   @map("cover_image")
  fileUrl       String?   @map("file_url")
  category      String
  level         Level
  isFree        Boolean   @default(false)
  publishedAt   DateTime? @map("published_at")
  
  // Relations
  bookClubs     BookClub[]
  
  @@map("books")
}

model BookClub {
  id            String           @id @default(cuid())
  name          String
  description   String           @db.Text
  coverImage    String?          @map("cover_image")
  isPublic      Boolean          @default(true) @map("is_public")
  maxMembers    Int?             @default(20) @map("max_members")
  creatorId     String           @map("creator_id")
  bookId        String           @map("book_id")
  nextMeeting   DateTime?        @map("next_meeting")
  meetingLink   String?          @map("meeting_link")
  
  // Relations
  creator      User             @relation("BookClubCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  members      BookClubMember[]
  discussions  Discussion[]
  
  @@map("book_clubs")
}

model BookClubMember {
  id          String   @id @default(cuid())
  bookClubId  String   @map("book_club_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")
  isModerator Boolean  @default(false) @map("is_moderator")
  
  // Relations
  bookClub    BookClub @relation(fields: [bookClubId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([bookClubId, userId])
  @@map("book_club_members")
}

model Discussion {
  id          String       @id @default(cuid())
  title       String
  content     String       @db.Text
  bookClubId  String       @map("book_club_id")
  authorId    String       @map("author_id")
  parentId    String?      @map("parent_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  // Relations
  bookClub    BookClub    @relation(fields: [bookClubId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Discussion? @relation("DiscussionReplies", fields: [parentId], references: [id])
  replies     Discussion[] @relation("DiscussionReplies")
  
  @@map("discussions")
}

model Message {
  id          String    @id @default(cuid())
  content     String    @db.Text
  senderId    String    @map("sender_id")
  recipientId String?   @map("recipient_id")
  roomId      String?   @map("room_id")
  isRead      Boolean   @default(false) @map("is_read")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // Relations
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  
  @@map("messages")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        NotificationType
  title       String
  message     String    @db.Text
  isRead      Boolean   @default(false) @map("is_read")
  link        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

model UserActivity {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  activityType String    @map("activity_type")
  duration     Int?      // in minutes
  createdAt    DateTime  @default(now()) @map("created_at")
  
  @@map("user_activities")
}

model LessonCompletion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")
  
  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  completed Boolean  @default(false)
  progress  Int      @default(0) // percentage 0-100
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model File {
  id            String   @id @default(cuid())
  filename      String
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  size          Int
  url           String
  path          String
  category      String   @default("content")
  isPublic      Boolean  @default(true) @map("is_public")
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([category])
  @@map("files")
}

// Enums
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  PENDING_TEACHER
}

enum Level {
  NOVICE
  BEGINNER
  INTERMEDIATE
  ADVANCED
  FLUENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum NotificationType {
  SYSTEM
  COURSE
  ASSIGNMENT
  SESSION
  MESSAGE
  BOOK_CLUB
  PAYMENT
}
